# 机器人 QQ 登录由 NapCat/QQ 客户端完成
BOT_QQ_ID=123456789

# NapCat 网络配置中的 Token（可选，留空不验证）
ONEBOT_ACCESS_TOKEN=

# DeepSeek API（或其他 OpenAI 兼容接口）
AI_API_KEY=请填写API_Key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 留空=回复所有好友；可填逗号分隔的 QQ 号
QQ_ALLOW_USERS=

# 留空=允许所有群；可填逗号分隔的群号
QQ_ALLOW_GROUPS=

# 温柔对待的QQ号（逗号分隔），对这些用户说话温柔、称呼"小主人"
GENTLE_TARGET_USERS=

# mention：仅被 @ 时回复；all：回复群内所有文字消息
GROUP_REPLY_MODE=mention

# 对话历史保留轮数
HISTORY_TURNS=10

# AI 配置
AI_MAX_TOKENS=300
AI_TIMEOUT_SECONDS=60
MIN_REPLY_INTERVAL_SECONDS=1.5

# 服务配置
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# AI 调用失败时的回复
ERROR_REPLY=机器人刚才走神了~等会儿再来！

# 系统人设（可选覆盖默认风格）
# SYSTEM_PROMPT=你是一个QQ聊天机器人...
