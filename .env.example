# 机器人 QQ 登录由 NapCat/QQ 客户端完成
BOT_QQ_ID=123456789

# NapCat 网络配置中的 Token（可选，留空不验证）
ONEBOT_ACCESS_TOKEN=

# DeepSeek API（或其他 OpenAI 兼容接口）
AI_API_KEY=请填写API_Key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 留空=回复所有好友；可填逗号分隔的 QQ 号
QQ_ALLOW_USERS=

# 留空=允许所有群；可填逗号分隔的群号
QQ_ALLOW_GROUPS=

# 温柔对待的QQ号（逗号分隔），对这些用户说话温柔、称呼"小主人"
GENTLE_TARGET_USERS=

# mention：仅被 @ 时回复；all：回复群内所有文字消息
GROUP_REPLY_MODE=mention

# 对话历史保留轮数
HISTORY_TURNS=10

# ========== AI 配置 ==========
# AI 最大输出 Token（建议 80-150 减少长回复分段，降低风控风险）
AI_MAX_TOKENS=150
AI_TIMEOUT_SECONDS=60

# ========== 风控保护 ==========
# 最小回复间隔（秒），建议 3-8 秒
MIN_REPLY_INTERVAL_SECONDS=3.0
# 回复间隔随机抖动范围（秒），在基础间隔上额外随机增加 0~此值的延迟
REPLY_JITTER_SECONDS=2.0
# 长消息分段发送时，每段之间的间隔（秒）
INTER_SEGMENT_DELAY_SECONDS=1.5
# 全局限流：在时间窗口内最多发送的消息数
GLOBAL_RATE_LIMIT_COUNT=20
# 全局限流：滑动时间窗口（秒）
GLOBAL_RATE_LIMIT_WINDOW=60
# 每日消息预警上限（0=不限），达到后日志警告
DAILY_MSG_CAP=300
# URL 处理模式：replace=替换为占位符, warn=隐藏警告, none=不过滤
URL_REPLACE_MODE=replace
# 渐进冷却：用户频繁触发时自动延长冷却（true/false）
ESCALATION_COOLDOWN=true

# ========== 服务配置 ==========
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# AI 调用失败时的回复
ERROR_REPLY=机器人刚才走神了~等会儿再来！

# 系统人设（可选覆盖默认风格）
# 【风控注意】毒舌/攻击性风格可能触发 QQ 内容风控，建议使用温和风格
# 温和推荐：你是一个友好可爱的QQ聊天助手。回复简短，不超过30字。
# SYSTEM_PROMPT=你是一个QQ聊天机器人...
